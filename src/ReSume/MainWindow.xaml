<Window x:Class="ReSume.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReSume" Height="650" Width="900">
    <TabControl>
        <TabItem Header="Sessions">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left panel -->
                <Grid Grid.Column="0" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="SaveButton" Content="Save Session" Width="100" Click="SaveButton_Click" Margin="0,0,10,0"/>
                        <Button x:Name="SaveShutdownButton" Content="Save &amp; Shutdown" Width="120" Click="SaveShutdownButton_Click"/>
                    </StackPanel>
                    <ListBox x:Name="SessionsListBox" Grid.Row="1" SelectionChanged="SessionsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Applications.Count, StringFormat='Apps: {0}'}" FontSize="11"/>
                                    </StackPanel>
                                    <Button Content="✕" Width="25" Height="25" Click="DeleteSession_Click" Tag="{Binding SessionId}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Right panel: detail + restore -->
                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer>
                        <StackPanel x:Name="DetailPanel">
                            <TextBlock Text="Select a session" FontStyle="Italic" Foreground="Gray"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="RestoreButton" Content="Restore Selected" Grid.Row="1" Height="30" Click="RestoreButton_Click"/>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Diagnostics">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer>
                    <StackPanel x:Name="DiagnosticsPanel"/>
                </ScrollViewer>
                <Button Content="Run Diagnostics" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Click="RunDiagnostics_Click"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>