<Window x:Class="ReSume.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReSume" Height="700" Width="1000"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}">

    <Window.Resources>
        <!-- ── Light palette ── -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- intentionally empty; colours set via code-behind on load -->
            </ResourceDictionary.MergedDictionaries>

            <!-- Reusable brushes (overridden by ApplyTheme) -->
            <SolidColorBrush x:Key="WindowBg"         Color="#F5F6FA"/>
            <SolidColorBrush x:Key="SidebarBg"        Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DetailBg"         Color="#FAFBFD"/>
            <SolidColorBrush x:Key="CardBg"           Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorder"       Color="#E2E5ED"/>
            <SolidColorBrush x:Key="CardHover"        Color="#EEF2FF"/>
            <SolidColorBrush x:Key="CardSelected"     Color="#E0E8FF"/>
            <SolidColorBrush x:Key="AccentBlue"       Color="#4F6EF7"/>
            <SolidColorBrush x:Key="AccentBlueDark"   Color="#3A56D4"/>
            <SolidColorBrush x:Key="AccentRed"        Color="#EF4444"/>
            <SolidColorBrush x:Key="AccentGreen"      Color="#22C55E"/>
            <SolidColorBrush x:Key="AccentAmber"      Color="#F59E0B"/>
            <SolidColorBrush x:Key="TextPrimary"      Color="#1A1D2E"/>
            <SolidColorBrush x:Key="TextSecondary"    Color="#6B7280"/>
            <SolidColorBrush x:Key="TextMuted"        Color="#9CA3AF"/>
            <SolidColorBrush x:Key="Divider"          Color="#E5E7EB"/>
            <SolidColorBrush x:Key="TabBarBg"         Color="#FFFFFF"/>
            <SolidColorBrush x:Key="HeaderBg"         Color="#F0F2F8"/>
            <SolidColorBrush x:Key="ButtonSecBg"      Color="#F3F4F6"/>
            <SolidColorBrush x:Key="ButtonSecFg"      Color="#374151"/>
            <SolidColorBrush x:Key="ButtonSecBorder"  Color="#D1D5DB"/>
            <SolidColorBrush x:Key="TagAppBg"         Color="#EEF2FF"/>
            <SolidColorBrush x:Key="TagAppFg"         Color="#4F46E5"/>
            <SolidColorBrush x:Key="TagBrowserBg"     Color="#F0FDF4"/>
            <SolidColorBrush x:Key="TagBrowserFg"     Color="#16A34A"/>
            <SolidColorBrush x:Key="SectionHeaderFg"  Color="#374151"/>
            <SolidColorBrush x:Key="DiagPassBg"       Color="#F0FDF4"/>
            <SolidColorBrush x:Key="DiagFailBg"       Color="#FEF2F2"/>
            <SolidColorBrush x:Key="DiagPassBorder"   Color="#BBF7D0"/>
            <SolidColorBrush x:Key="DiagFailBorder"   Color="#FEE2E2"/>

            <!-- Primary action button -->
            <Style x:Key="BtnPrimary" TargetType="Button">
                <Setter Property="Background"   Value="{DynamicResource AccentBlue}"/>
                <Setter Property="Foreground"   Value="White"/>
                <Setter Property="FontSize"     Value="13"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="Padding"      Value="14,7"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor"       Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBlueDark}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Secondary button -->
            <Style x:Key="BtnSecondary" TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource ButtonSecBg}"/>
                <Setter Property="Foreground"      Value="{DynamicResource ButtonSecFg}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource ButtonSecBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="Padding"         Value="12,6"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource CardHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Danger button -->
            <Style x:Key="BtnDanger" TargetType="Button">
                <Setter Property="Background"   Value="Transparent"/>
                <Setter Property="Foreground"   Value="{DynamicResource TextMuted}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor"       Value="Hand"/>
                <Setter Property="Width"        Value="26"/>
                <Setter Property="Height"       Value="26"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="brd" Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="brd" Property="Background" Value="#FFEAE8"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rename button -->
            <Style x:Key="BtnRename" TargetType="Button" BasedOn="{StaticResource BtnDanger}">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Session list item card -->
            <Style x:Key="SessionCard" TargetType="ListBoxItem">
                <Setter Property="Background"      Value="{DynamicResource CardBg}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin"          Value="0,0,0,6"/>
                <Setter Property="Padding"         Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="cardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" Padding="12,10">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource CardHover}"/>
                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource CardSelected}"/>
                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tab style -->
            <Style x:Key="MainTab" TargetType="TabItem">
                <Setter Property="FontSize"     Value="13"/>
                <Setter Property="Padding"      Value="20,10"/>
                <Setter Property="Foreground"   Value="{DynamicResource TextSecondary}"/>
                <Setter Property="Background"   Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="tabBorder" Padding="{TemplateBinding Padding}" Background="Transparent">
                                <Grid>
                                    <ContentPresenter x:Name="label" ContentSource="Header"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextBlock.FontWeight="Medium"/>
                                    <Border x:Name="indicator" Height="3" CornerRadius="2"
                                            Background="{DynamicResource AccentBlue}"
                                            VerticalAlignment="Bottom" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                    <Setter TargetName="label" Property="TextBlock.FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource CardHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ListBox chrome-less -->
            <Style x:Key="ChromelessListBox" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource SessionCard}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Top bar -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ── Top title bar ── -->
        <Border Grid.Row="0" Background="{DynamicResource TabBarBg}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12">
                    <Border Width="28" Height="28" CornerRadius="7"
                            Background="{DynamicResource AccentBlue}" Margin="0,0,10,0">
                        <TextBlock Text="R" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ReSume" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Tabs -->
                <TabControl x:Name="MainTabControl" Grid.Column="1"
                            Background="Transparent" BorderThickness="0"
                            Margin="20,0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="0"/>
                                </Grid.RowDefinitions>
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem x:Name="TabSessions"  Header="Sessions"    Style="{StaticResource MainTab}"/>
                    <TabItem x:Name="TabDiag"      Header="Diagnostics" Style="{StaticResource MainTab}"/>
                </TabControl>

                <!-- Dark mode toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12">
                    <TextBlock x:Name="ThemeLabel" Text="☀" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <ToggleButton x:Name="ThemeToggle" Width="44" Height="24"
                                  Checked="ThemeToggle_Checked" Unchecked="ThemeToggle_Unchecked"
                                  Cursor="Hand" ToolTip="Toggle dark / light mode">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="track" CornerRadius="12" Width="44" Height="24"
                                        Background="{DynamicResource TextMuted}">
                                    <Border x:Name="thumb" Width="18" Height="18" CornerRadius="9"
                                            Background="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                        <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock x:Name="ThemeLabelRight" Text="🌙" FontSize="14"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main content area ── -->
        <Grid Grid.Row="1">
            <!-- Sessions panel -->
            <Grid x:Name="SessionsPanel" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left sidebar ── -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBg}"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Sidebar header -->
                        <Border Grid.Row="0" Padding="14,14,14,10"
                                Background="{DynamicResource HeaderBg}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Saved Sessions" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextTransform="Uppercase" LetterSpacing="0.5"/>
                                <TextBlock x:Name="SessionCountLabel" Text="0 sessions"
                                           FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Session list -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,10,10,0">
                            <ListBox x:Name="SessionsListBox"
                                     Style="{StaticResource ChromelessListBox}"
                                     SelectionChanged="SessionsListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy  HH:mm}'}"
                                                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,3"/>
                                                <WrapPanel>
                                                    <Border Background="{DynamicResource TagAppBg}" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource TagAppFg}"
                                                                   Text="{Binding Applications.Count, StringFormat='🖥 {0} apps'}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource TagBrowserBg}" CornerRadius="4" Padding="5,2">
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource TagBrowserFg}"
                                                                   Text="{Binding BrowserProfiles.Count, StringFormat='🌐 {0} profiles'}"/>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                            <!-- Action buttons (show on hover via the ListBoxItem style interaction) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
                                                <Button Content="✏" ToolTip="Rename"
                                                        Style="{StaticResource BtnRename}"
                                                        Click="RenameSession_Click" Tag="{Binding SessionId}"/>
                                                <Button Content="✕" ToolTip="Delete"
                                                        Style="{StaticResource BtnDanger}"
                                                        Click="DeleteSession_Click" Tag="{Binding SessionId}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>

                        <!-- Sidebar action buttons -->
                        <Border Grid.Row="2" Padding="10,10,10,12"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Button x:Name="SaveButton" Content="💾  Save Session"
                                        Style="{StaticResource BtnPrimary}"
                                        Click="SaveButton_Click" Margin="0,0,0,6"/>
                                <Button x:Name="SaveShutdownButton" Content="⏻  Save &amp; Shutdown"
                                        Style="{StaticResource BtnSecondary}"
                                        Click="SaveShutdownButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Resize grip -->
                <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center"
                              Background="{DynamicResource Divider}" ResizeBehavior="PreviousAndNext"/>

                <!-- ── Right detail panel ── -->
                <Border Grid.Column="2" Background="{DynamicResource DetailBg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DetailPanel" Margin="24,20,24,10">
                                <!-- Placeholder shown when nothing selected -->
                                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="0,60,0,0">
                                    <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No session selected" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center" Margin="0,12,0,6"/>
                                    <TextBlock Text="Pick a session from the list, or save a new one."
                                               FontSize="12" Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Restore button bar -->
                        <Border Grid.Row="1" Padding="24,10,24,16"
                                Background="{DynamicResource SidebarBg}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RestoreButton" Content="▶  Restore Session"
                                        Style="{StaticResource BtnPrimary}"
                                        IsEnabled="False" Click="RestoreButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Diagnostics panel -->
            <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" Padding="24,20,24,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DiagnosticsStack"/>
                </ScrollViewer>
                <Border Grid.Row="1" Padding="24,10,24,16"
                        Background="{DynamicResource SidebarBg}"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                    <Button Content="🔍  Run Diagnostics" Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Right" Click="RunDiagnostics_Click"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" Height="28"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="16,0">
                <TextBlock x:Name="StatusBar" Text="Ready"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
