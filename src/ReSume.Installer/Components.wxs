<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="ReSume">
          <Component Id="MainExe" Guid="*"><File Id="ReSumeExe" Source="..\ReSume\bin\Release\net8.0-windows\publish\ReSume.exe" /></Component>
          <Directory Id="NativeHostDir" Name="NativeHost">
            <Component Id="NativeHostExe" Guid="*"><File Id="NhExe" Source="..\ReSume.NativeHost\bin\Release\net8.0\publish\ReSume.NativeHost.exe" /></Component>
          </Directory>
          <Component Id="ChromeMan" Guid="*">
            <File Id="ChromeManFile" Source="nativehost-manifest.json" />
            <RegistryValue Root="HKCU" Key="Software\Google\Chrome\NativeMessagingHosts\com.resume.nativehost" Value="[INSTALLFOLDER]nativehost-manifest.json" Type="string" />
          </Component>
          <Component Id="EdgeMan" Guid="*">
            <File Id="EdgeManFile" Source="nativehost-manifest-edge.json" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Edge\NativeMessagingHosts\com.resume.nativehost" Value="[INSTALLFOLDER]nativehost-manifest-edge.json" Type="string" />
          </Component>
        </Directory>
      </Directory>
    </DirectoryRef>
    <ComponentGroup Id="MainComponents">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="NativeHostExe" />
      <ComponentRef Id="ChromeMan" />
      <ComponentRef Id="EdgeMan" />
    </ComponentGroup>
  </Fragment>
</Wix>